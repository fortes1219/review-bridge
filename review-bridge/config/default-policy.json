{
  "schema_version": 5,
  "policy_schema_version": 5,
  "package_policy_id": "review-bridge-default",
  "limits": {
    "rounds": 2,
    "call_timeout": 900000,
    "max_turns": 20,
    "tokens_per_call": 1500000,
    "tokens": 4000000,
    "test_timeout": 600000,
    "run_timeout": 21600000,
    "authorization_ttl": 86400000,
    "recovery_window": 86400000,
    "heartbeat_interval": 5000,
    "lock_stale": 30000,
    "reconcile_grace": 5000,
    "reconcile_guard_ttl": 15000
  },
  "writer": {
    "mode": "writer_only",
    "disallowed_tools": [],
    "self_review": "one_local_consistency_pass"
  },
  "hard_stops": [
    "new human decision required",
    "approved or ratified decision must be reopened",
    "scope expansion or another work package",
    "change type or path outside the authorized work package",
    "commit, push, deploy, release, or adapter activation",
    "malformed or missing machine-readable review gate",
    "token, call-count, or wall-clock budget exhausted",
    "authentication or rate-limit failure"
  ],
  "priority": {
    "default": "medium",
    "writer": {
      "low": { "model": "opus", "effort": "low" },
      "medium": { "model": "opus", "effort": "medium" },
      "high": { "model": "opus", "effort": "high" },
      "urgent": { "model": "opus", "effort": "high" }
    },
    "reviewer": {
      "low": { "model": null, "effort": "low" },
      "medium": { "model": null, "effort": "medium" },
      "high": { "model": null, "effort": "high" },
      "urgent": { "model": null, "effort": "high" }
    }
  },
  "release_actions_require_human": true
}
