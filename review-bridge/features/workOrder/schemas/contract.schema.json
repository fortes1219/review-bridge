{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review-bridge.contract",
  "description": "A sealed work-order contract: the work-order text as authorized, every field Bridge copied from the work order's marked blocks, the conditions a writer cut from its acceptance blocks and a reviewer checked, and who did both. Read-only after sealing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "work_package_id",
    "source",
    "translated_by",
    "checked_by",
    "ticket",
    "context",
    "outcome",
    "requested_work",
    "scope_notes",
    "run_plan",
    "acceptance",
    "verification_hints",
    "reproduction",
    "references",
    "open_questions",
    "unused_lines"
  ],
  "properties": {
    "schema": {
      "const": "review-bridge.contract"
    },
    "schema_version": {
      "const": 2
    },
    "work_package_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "lines"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "translated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "provider",
        "model",
        "attempt"
      ],
      "properties": {
        "role": {
          "const": "writer"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "checked_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "provider"
      ],
      "properties": {
        "role": {
          "const": "reviewer"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        }
      }
    },
