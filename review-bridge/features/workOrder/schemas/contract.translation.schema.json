{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "contract.translation",
  "description": "What a model contributes to a work-order contract: the work order's acceptance blocks cut into conditions. Bridge fills every other field from the work order's marked blocks itself. Each condition carries a verbatim quote of its lines, which lie in one acceptance block. Scope, budget, roles and the verification command are not here; the controller owns them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "acceptance"
  ],
  "properties": {
    "event": {
      "const": "contract.translation"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "quote",
          "source_refs",
          "verify"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[1-9][0-9]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "verify": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "check"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "test",
                    "reviewer"
                  ]
                },
                "check": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    }
  }
}
