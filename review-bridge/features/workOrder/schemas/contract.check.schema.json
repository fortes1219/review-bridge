{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "contract.check",
  "description": "The independent reviewer's reading of the conditions a writer cut from the work order's acceptance blocks. It lowers the risk of a condition that drifts from its lines or one that is missing; it does not prove the conditions faithful.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "candidate_sha256",
    "acceptance",
    "missing",
    "ambiguities",
    "cannot_confirm",
    "cannot_confirm_reason"
  ],
  "properties": {
    "event": {
      "const": "contract.check"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "faithful",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[1-9][0-9]*$"
          },
          "faithful": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_refs",
          "note"
        ],
        "properties": {
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "source_refs",
          "blocks",
          "convention",
          "acceptance_proposal",
          "readings"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "blocks": {
            "enum": [
              "verification",
              "implementation",
              "preference"
            ]
          },
          "convention": {
            "type": "boolean"
          },
          "acceptance_proposal": {
            "type": "boolean"
          },
          "readings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "precedent"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "precedent": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "note"
                  ],
                  "properties": {
                    "source": {
                      "enum": [
                        "project",
                        "lookup",
                        "knowledge"
                      ]
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "cannot_confirm": {
      "type": "boolean"
    },
    "cannot_confirm_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    }
  }
}
