{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "contract.check",
  "description": "The independent reviewer's reading of one translation against the full work order. It lowers the risk of a translation that drifts from the work order; it does not prove the translation faithful.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "candidate_sha256",
    "fields",
    "acceptance",
    "missing",
    "ambiguities",
    "cannot_confirm",
    "cannot_confirm_reason"
  ],
  "properties": {
    "event": {
      "const": "contract.check"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "faithful",
          "note"
        ],
        "properties": {
          "field": {
            "enum": [
              "ticket",
              "context",
              "outcome",
              "requested_work",
              "scope_notes.include",
              "scope_notes.exclude",
              "scope_notes.must_keep",
              "scope_notes.expected_locations",
              "run_plan",
              "verification_hints",
              "reproduction",
              "references",
              "unused_lines"
            ]
          },
          "faithful": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "faithful",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[1-9][0-9]*$"
          },
          "faithful": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_refs",
          "note"
        ],
        "properties": {
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "source_refs"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "cannot_confirm": {
      "type": "boolean"
    },
    "cannot_confirm_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    }
  }
}
