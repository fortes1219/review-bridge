{
  "schema_version": 2,
  "profile_id": "next-frontend",
  "display_name": "Next.js frontend",
  "required_files_any": [
    "package.json"
  ],
  "auto_detection": {
    "files_any": [
      "package.json"
    ],
    "content_any": [
      {
        "file": "package.json",
        "patterns": [
          "\\\"next\\\"\\s*:"
        ]
      }
    ]
  },
  "verification_rules": [
    {
      "command": "npm test",
      "package_script": "test"
    }
  ],
  "verification_script_candidates": [
    "format:check",
    "lint",
    "typecheck",
    "test:run",
    "test",
    "build"
  ],
  "dependency_manifest": {
    "file": "package.json",
    "sections": [
      "dependencies",
      "devDependencies"
    ],
    "script_section": "scripts",
    "script_runner": "npm run",
    "capabilities": [
      {
        "name": "next",
        "dependencies": [
          "next"
        ]
      },
      {
        "name": "react",
        "dependencies": [
          "react"
        ]
      },
      {
        "name": "typescript",
        "dependencies": [
          "typescript"
        ]
      }
    ]
  }
}
