{
  "name": "codex-review-bridge-installer",
  "version": "0.2.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Fail-closed installer for the Claude-to-Codex review bridge",
  "bin": {
    "review-bridge": "./bridge.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:runtime": "node --test review-bridge/tests/integration.test.mjs review-bridge/tests/platform.test.mjs",
    "test:state-v4": "node --test review-bridge/tests/state-v4.acceptance.test.mjs",
    "test:state-v4:evidence": "node scripts/run-state-v4-acceptance.mjs",
    "checksums": "node scripts/generate-checksums.mjs",
    "verify:archive": "node scripts/verify-release-archive.mjs",
    "package:release": "node scripts/package-release.mjs",
    "smoke:windows": "node review-bridge/tests/native-adapter-smoke.mjs",
    "smoke:claude-session-live": "node review-bridge/tests/native-claude-session-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
