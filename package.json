{
  "name": "review-bridge",
  "version": "0.2.0-rc.2",
  "type": "module",
  "description": "Run a writer agent and an independent read-only reviewer on your work orders, with fail-closed gates and human breakpoints.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fortes1219/review-bridge.git"
  },
  "bin": {
    "review-bridge": "./bridge.mjs"
  },
  "files": [
    "bridge.mjs",
    "review-bridge/",
    "!review-bridge/tests/",
    "review-bridge/tests/fixtures/fake-claude.mjs",
    "review-bridge/tests/fixtures/fake-codex.mjs",
    "installer/",
    "profiles/",
    "project-templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:runtime": "node --test review-bridge/tests/integration.test.mjs review-bridge/tests/platform.test.mjs",
    "test:state-contract": "node --test review-bridge/tests/state-contract.acceptance.test.mjs",
    "smoke:windows": "node review-bridge/tests/native-adapter-smoke.mjs",
    "smoke:claude-session-live": "node review-bridge/tests/native-claude-session-smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.1.0"
  }
}
