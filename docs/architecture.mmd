flowchart TD
    O["Human owner<br/>Approves exact package checksum"]
    W[("Immutable work package<br/>task / scope / budget / breakpoint")]
    A[("Immutable authorization<br/>owner / expiry / package + policy SHA")]
    C[("Exclusive claim<br/>authorization -> one run")]
    S[("Immutable policy snapshot<br/>tighten-only merge")]
    U[("Mutable run projection<br/>session / budget / current status")]
    E[("Append-only per-run events<br/>fsync before projection")]
    K["Controller<br/>locks / recovery / queue / gates"]
    CW["Claude Code<br/>bounded writer session"]
    H["Claude Stop hook<br/>event trigger only"]
    X["Codex CLI<br/>ephemeral read-only review"]
    G{"REVIEW_GATE<br/>HARD_STOP_REQUIRED"}
    B["Human breakpoint<br/>terminal run or new decision"]

    O --> W
    O --> A
    W --> A
    S --> A
    A --> C
    C --> U
    U --> K
    E --> K
    K -->|"event first"| E
    K -->|"then atomic projection"| U
    K --> CW
    CW --> H
    H --> K
    K --> X
    X --> G
    G -->|"FAIL + no hard stop<br/>within authorized budget"| K
    K -->|"named findings only<br/>same run and session"| CW
    G -->|"PASS / hard stop / malformed / budget"| B
    B --> O
